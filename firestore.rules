rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 익명 로그인(비밀번호 없이 앱이 자동으로 로그인)이라도, 로그인된 상태여야만
    // 읽고 쓸 수 있게 제한합니다. 완전 공개(누구나 URL만 알면 접근)보다 안전한
    // 최소한의 보호 장치입니다.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
